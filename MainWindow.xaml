<Window x:Class="AutoCommand.Matrix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoCommand Matrix"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <!-- Two stacked surfaces: the dim ambient backdrop below, the
             falling rain (and PID labels) above — WPF composites both with
             per-pixel alpha, so the backdrop's steady brightness never
             fights the rain's fading trails. -->
        <Image x:Name="AmbientImage" />
        <Image x:Name="RainImage" />
    </Grid>
</Window>
